PORT=3000

# MongoDB connection string (no real credentials here)
# Local:  mongodb://127.0.0.1:27017/fix-clean-co
# Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/fix-clean-co?retryWrites=true&w=majority
MONGODB_URI=

# JWT signing secret — a random string of at least 32 characters.
# Generate one with: openssl rand -hex 64
JWT_SECRET=
# Access token lifetime, e.g. 15m, 1h, 1d (defaults to 1d)
JWT_EXPIRES_IN=1d
